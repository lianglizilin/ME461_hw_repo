// SWI_isr,  Using this interrupt as a Software started interrupt
__interrupt void SWI_isr(void) {

    // These three lines of code allow SWI_isr, to be interrupted by other interrupt functions
	// making it lower priority than all other Hardware interrupts.  
	PieCtrlRegs.PIEACK.all = PIEACK_GROUP12;
    asm("       NOP");                    // Wait one cycle
    EINT;                                 // Clear INTM to enable interrupts
	
	
	
    // Insert SWI ISR Code here.......
	
	
    numSWIcalls++;
    
    DINT;

}

// cpu_timer0_isr - CPU Timer0 ISR
__interrupt void cpu_timer0_isr(void)
{
    numTimer0calls++;

    // HW3: Update servos every 10 ms, as configured in LABstarter.
    // Joystick ADC data was sampled by the Lab 4 ADCA interrupt.
    if (joystickEnable == 1 && adcacount > 0) {
        // Start with a small +/- 10 degree command range.
        servoAngleX = servoCenterX + ((float)adca2result - 2048.0) * (10.0 / 2048.0);
        servoAngleY = servoCenterY + ((float)adca3result - 2048.0) * (10.0 / 2048.0);
    } else {
        servoAngleX = servoCenterX;
        servoAngleY = servoCenterY;
    }
    setEPWM8A_RCServo(servoAngleX);
    setEPWM8B_RCServo(servoAngleY);


//    if ((numTimer0calls%50) == 0) {
//        PieCtrlRegs.PIEIFR12.bit.INTx9 = 1;  // Manually cause the interrupt for the SWI
//    }

    if ((numTimer0calls%25) == 0) {
        displayLEDletter(LEDdisplaynum);
        LEDdisplaynum++;
        if (LEDdisplaynum == 0xFFFF) {  // prevent roll over exception
            LEDdisplaynum = 0;
        }
    }

    if ((numTimer0calls%50) == 0) {
		// Blink LaunchPad Red LED
		GpioDataRegs.GPBTOGGLE.bit.GPIO34 = 1;
    }


    // Acknowledge this interrupt to receive more interrupts from group 1
    PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;
}

// cpu_timer1_isr - CPU Timer1 ISR
__interrupt void cpu_timer1_isr(void)
{
		
    numTimer1calls++;
}

// cpu_timer2_isr CPU Timer2 ISR
__interrupt void cpu_timer2_isr(void)
{
	// Blink LaunchPad Blue LED
    GpioDataRegs.GPATOGGLE.bit.GPIO31 = 1;

    numTimer2calls++;
	
	if ((numTimer2calls % 10) == 0) {
		UARTPrint = 1;
	}
}


// HW3: Same interrupt result read and acknowledge as Lab 4.
__interrupt void ADCA_ISR(void) {
    adca2result = AdcaResultRegs.ADCRESULT0;
    adca3result = AdcaResultRegs.ADCRESULT1;
    adcacount++;
    // Recover from an ADC interrupt overflow if one occurred.
    if (AdcaRegs.ADCINTOVF.bit.ADCINT1 == 1) {
        AdcaRegs.ADCINTOVFCLR.bit.ADCINT1 = 1;
    }
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;
}

// HW3: Lab 3 servo helper functions, with the original typo fixed
// (angle > -90.0 changed to angle = -90.0).
void setEPWM8A_RCServo(float angle) {
    float dutyCycle = 0.0;
    if (angle > 90.0) {
        angle = 90.0;
    }
    if (angle < -90.0) {
        angle = -90.0;
    }
    dutyCycle = 0.08 + angle * (0.04 / 90.0);
    EPwm8Regs.CMPA.bit.CMPA = (uint16_t)(dutyCycle * (float)EPwm8Regs.TBPRD);
}

void setEPWM8B_RCServo(float angle) {
    float dutyCycle = 0.0;
    if (angle > 90.0) {
        angle = 90.0;
    }
    if (angle < -90.0) {
        angle = -90.0;
    }
    dutyCycle = 0.08 + angle * (0.04 / 90.0);
    EPwm8Regs.CMPB.bit.CMPB = (uint16_t)(dutyCycle * (float)EPwm8Regs.TBPRD);
}
